# This env file documents configuration for the Auth service container.
PORT=3001
REDIS_URL=redis://redis:6379
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----REPLACE_ME-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----REPLACE_ME-----END PUBLIC KEY-----

# Email (for OTP delivery via nodemailer)
HOST=smtp.gmail.com
SERVICE=gmail
EMAIL_PORT=587
SECURE=false
USER=your-email@gmail.com
PASS=your-app-password

