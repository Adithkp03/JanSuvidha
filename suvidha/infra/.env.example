# This .env.example file documents all environment variables required for the JanSuvidha Phase 0 stack.
POSTGRES_USER=suvidha
POSTGRES_PASSWORD=suvidha_password_change_me
POSTGRES_DB=suvidha_db

MINIO_ROOT_USER=suvidha_minio_user
MINIO_ROOT_PASSWORD=suvidha_minio_password_change_me

RABBITMQ_DEFAULT_USER=suvidha_rabbit
RABBITMQ_DEFAULT_PASS=suvidha_rabbit_password_change_me

JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----REPLACE_ME-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----REPLACE_ME-----END PUBLIC KEY-----

# Optional: override ports if needed
# API_GATEWAY_PORT=3000
# KIOSK_FRONTEND_PORT=5173

